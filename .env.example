# Nuri Backend — Required Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.

# PostgreSQL connection string from Render (use EXTERNAL URL for local dev)
DATABASE_URL=postgresql://user:password@host/dbname

# Comma-separated allowed frontend origins for CORS
# e.g. https://nuri001.vercel.app
ALLOWED_ORIGIN=https://nuri001.vercel.app

# Port the Express server listens on (Render sets this automatically)
PORT=5000
