# Nuri Backend — Required Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.

# PostgreSQL connection string from Render (use EXTERNAL URL for local dev)
DATABASE_URL=postgresql://user:password@host/dbname

# Comma-separated allowed frontend origins for CORS
# e.g. https://nuri001.vercel.app
ALLOWED_ORIGIN=https://nuri001.vercel.app

# Port the Express server listens on (Render sets this automatically)
PORT=5000

# ── Vite (frontend) env vars ──────────────────────────────────────────────────
# Auth0 credentials
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=

# URL of the Express backend — http://localhost:5000 for local, Render URL for production
VITE_BACKEND_URL=https://your-nuri-backend.onrender.com

# PostgreSQL connection string from Render (use EXTERNAL URL for local dev)
DATABASE_URL=postgresql://user:password@host/dbname

# Comma-separated allowed frontend origins for CORS
# e.g. https://nuri001.vercel.app
ALLOWED_ORIGIN=https://nuri001.vercel.app

# Port the Express server listens on (Render sets this automatically)
PORT=5000
